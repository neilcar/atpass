{
  "name": "atpass",
  "version": "0.1.0",
  "description": "A password manager that stores your encrypted vault as records in your own atproto (Bluesky) PDS repo.",
  "type": "module",
  "private": true,
  "bin": {
    "atpass": "./dist/cli/index.js"
  },
  "files": [
    "dist",
    "lexicons",
    "README.md"
  ],
  "workspaces": [
    "web",
    "extension"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli/index.ts",
    "start": "node dist/cli/index.js",
    "web:dev": "npm run dev --workspace web",
    "web:build": "npm run build --workspace web",
    "ext:dev": "npm run dev --workspace extension",
    "ext:build": "npm run build --workspace extension",
    "test": "node scripts/run-tests.mjs"
  },
  "dependencies": {
    "@atproto/api": "^0.29.0",
    "@napi-rs/keyring": "^2.1.2",
    "@node-rs/argon2": "^2.2.2",
    "clipboardy": "^5.3.2",
    "commander": "^15.0.0",
    "prompts": "^2.4.2",
    "zod": "^3.25.76",
    "zxcvbn": "^4.4.2"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/prompts": "^2.4.9",
    "@types/zxcvbn": "^4.4.5",
    "hash-wasm": "^4.12.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22"
  }
}
